{
  "agent": "calendly",
  "label": "📅 Calendly API",
  "base_url": "https://api.calendly.com",
  "auth": {
    "type": "header",
    "format": "Bearer"
  },
  "headers": {
    "Accept": "application/json"
  },
  "endpoints": [
    {
      "name": "get_current_user",
      "label": "👤 Get Current User",
      "description": "Retrieve details of the authenticated user.",
      "method": "GET",
      "path": "/users/me",
      "examples": [
        {
          "url": "https://api.calendly.com/users/me",
          "parameters": {}
        }
      ],
      "notes": [
        "Useful for obtaining user and organization URIs for subsequent API calls."
      ]
    },
    {
      "name": "list_scheduled_events",
      "label": "📆 List Scheduled Events",
      "description": "Fetch scheduled events for a user or organization.",
      "method": "GET",
      "path": "/scheduled_events",
      "query_params": {
        "user": "User URI to filter events.",
        "organization": "Organization URI to filter events.",
        "invitee_email": "Filter events by invitee's email.",
        "status": "Event status: active or canceled.",
        "sort": "Sort order, e.g., start_time:asc.",
        "min_start_time": "ISO 8601 start time filter.",
        "max_start_time": "ISO 8601 end time filter.",
        "count": "Number of events to return.",
        "page_token": "Token for pagination."
      },
      "examples": [
        {
          "url": "https://api.calendly.com/scheduled_events?user=https://api.calendly.com/users/USER_ID&status=active&count=10",
          "parameters": {
            "user": "https://api.calendly.com/users/USER_ID",
            "status": "active",
            "count": "10"
          }
        }
      ],
      "notes": [
        "Requires either 'user' or 'organization' parameter.",
        "Pagination supported via 'count' and 'page_token'."
      ]
    },
    {
      "name": "get_event_details",
      "label": "🔍 Get Event Details",
      "description": "Retrieve detailed information about a specific event.",
      "method": "GET",
      "path": "/scheduled_events/{event_uuid}",
      "path_params": {
        "event_uuid": "Unique identifier of the event."
      },
      "examples": [
        {
          "url": "https://api.calendly.com/scheduled_events/abc123",
          "parameters": {
            "event_uuid": "abc123"
          }
        }
      ],
      "notes": [
        "Provides comprehensive details, including invitees and event metadata."
      ]
    },
    {
      "name": "list_event_invitees",
      "label": "👥 List Event Invitees",
      "description": "List all invitees for a specific event.",
      "method": "GET",
      "path": "/scheduled_events/{event_uuid}/invitees",
      "path_params": {
        "event_uuid": "Unique identifier of the event."
      },
      "query_params": {
        "status": "Invitee status: active or canceled.",
        "email": "Filter invitees by email.",
        "sort": "Sort order, e.g., created_at:asc.",
        "count": "Number of invitees to return.",
        "page_token": "Token for pagination."
      },
      "examples": [
        {
          "url": "https://api.calendly.com/scheduled_events/abc123/invitees?status=active&count=5",
          "parameters": {
            "event_uuid": "abc123",
            "status": "active",
            "count": "5"
          }
        }
      ],
      "notes": [
        "Useful for retrieving participant details and statuses."
      ]
    },
    {
      "name": "cancel_event",
      "label": "❌ Cancel Event",
      "description": "Cancel a specific scheduled event.",
      "method": "POST",
      "path": "/scheduled_events/{event_uuid}/cancellation",
      "path_params": {
        "event_uuid": "Unique identifier of the event."
      },
      "body_params": {
        "reason": "Reason for cancellation."
      },
      "examples": [
        {
          "url": "https://api.calendly.com/scheduled_events/abc123/cancellation",
          "parameters": {
            "event_uuid": "abc123",
            "reason": "Client requested cancellation."
          }
        }
      ],
      "notes": [
        "Only the entire event can be canceled; individual invitees cannot be canceled via this endpoint."
      ]
    },
    {
      "name": "list_event_type_available_times",
      "label": "🕒 List Event Type Available Times",
      "description": "Retrieve available time slots for a specific event type.",
      "method": "GET",
      "path": "/event_type_available_times",
      "query_params": {
        "event_type": "URI of the event type.",
        "start_time": "Start of the time range (ISO 8601).",
        "end_time": "End of the time range (ISO 8601).",
        "timezone": "Time zone for the availability times."
      },
      "examples": [
        {
          "url": "https://api.calendly.com/event_type_available_times?event_type=https://api.calendly.com/event_types/ET123&start_time=2025-05-01T00:00:00Z&end_time=2025-05-07T00:00:00Z&timezone=Australia/Sydney",
          "parameters": {
            "event_type": "https://api.calendly.com/event_types/ET123",
            "start_time": "2025-05-01T00:00:00Z",
            "end_time": "2025-05-07T00:00:00Z",
            "timezone": "Australia/Sydney"
          }
        }
      ],
      "notes": [
        "Returns available time slots within the specified range for the given event type."
      ]
    },
    {
      "name": "list_webhook_subscriptions",
      "label": "🔔 List Webhook Subscriptions",
      "description": "Retrieve all webhook subscriptions for the organization.",
      "method": "GET",
      "path": "/webhook_subscriptions",
      "query_params": {
        "organization": "Organization URI to filter webhooks.",
        "user": "User URI to filter webhooks."
      },
      "examples": [
        {
          "url": "https://api.calendly.com/webhook_subscriptions?organization=https://api.calendly.com/organizations/ORG123",
          "parameters": {
            "organization": "https://api.calendly.com/organizations/ORG123"
          }
        }
      ],
      "notes": [
        "Useful for managing and auditing existing webhook subscriptions."
      ]
    },
    {
      "name": "create_webhook_subscription",
      "label": "➕ Create Webhook Subscription",
      "description": "Subscribe to webhook events for real-time notifications.",
      "method": "POST",
      "path": "/webhook_subscriptions",
      "body_params": {
        "url": "The endpoint URL to receive webhook events.",
        "events": "List of event types to subscribe to, e.g., invitee.created.",
        "organization": "Organization URI for the subscription.",
        "user": "Optional user URI to scope the subscription."
      },
      "examples": [
        {
          "url": "https://api.calendly.com/webhook_subscriptions",
          "parameters": {
            "url": "https://yourapp.com/webhooks/calendly",
            "events": ["invitee.created", "invitee.canceled"],
            "organization": "https://api.calendly.com/organizations/ORG123"
          }
        }
      ],
      "notes": [
        "Ensure the receiving endpoint is publicly accessible and can handle POST requests."
      ]
    }
  ]
}
