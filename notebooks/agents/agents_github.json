{
  "agent": "github",
  "label": "🐙 GitHub Advanced API",
  "base_url": "https://api.github.com",
  "auth": {
    "type": "oauth",
    "code": "i"
  },
  "headers": {
    "Accept": "application/vnd.github+json",
    "User-Agent": "Invoke App"
  },
  "endpoints": [
    {
      "name": "get_user",
      "label": "🙋 Get Authenticated User",
      "description": "Returns info about the authenticated GitHub user.",
      "method": "GET",
      "path": "/user",
      "examples": [
        {
          "url": "https://api.github.com/user",
          "parameters": {}
        }
      ]
    },
    {
      "name": "list_repos",
      "label": "📦 List Repositories",
      "description": "List repositories for the authenticated user.",
      "method": "GET",
      "path": "/user/repos",
      "query_params": {
        "type": "all, owner, public, private, member",
        "sort": "created, updated, pushed, full_name",
        "direction": "asc or desc"
      },
      "examples": [
        {
          "url": "https://api.github.com/user/repos?type=owner&sort=updated",
          "parameters": {
            "type": "owner",
            "sort": "updated"
          }
        }
      ]
    },
    {
      "name": "list_issues",
      "label": "🐛 List Issues",
      "description": "List issues assigned to the user across all visible repositories.",
      "method": "GET",
      "path": "/issues",
      "query_params": {
        "filter": "assigned, created, mentioned, subscribed, all",
        "state": "open, closed, or all",
        "sort": "created, updated, comments",
        "direction": "asc or desc"
      },
      "examples": [
        {
          "url": "https://api.github.com/issues?filter=assigned&state=open",
          "parameters": {
            "filter": "assigned",
            "state": "open"
          }
        }
      ]
    },
    {
      "name": "list_pull_requests",
      "label": "🔀 List Pull Requests",
      "description": "List pull requests in a given repository.",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/pulls",
      "path_params": {
        "owner": "GitHub username or org",
        "repo": "Repository name"
      },
      "query_params": {
        "state": "open, closed, or all",
        "sort": "created, updated, popularity, long-running",
        "direction": "asc or desc"
      },
      "examples": [
        {
          "url": "https://api.github.com/repos/octocat/hello-world/pulls?state=open",
          "parameters": {
            "owner": "octocat",
            "repo": "hello-world",
            "state": "open"
          }
        }
      ]
    },
    {
      "name": "get_pull_request_files",
      "label": "📂 PR File Diffs",
      "description": "Get the list of files changed in a pull request.",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/pulls/{pull_number}/files",
      "path_params": {
        "owner": "GitHub username or org",
        "repo": "Repository name",
        "pull_number": "Pull request number"
      },
      "examples": [
        {
          "url": "https://api.github.com/repos/octocat/hello-world/pulls/42/files",
          "parameters": {
            "owner": "octocat",
            "repo": "hello-world",
            "pull_number": "42"
          }
        }
      ]
    },
    {
      "name": "comment_on_issue",
      "label": "💬 Comment on Issue",
      "description": "Post a comment on an issue or pull request.",
      "method": "POST",
      "path": "/repos/{owner}/{repo}/issues/{issue_number}/comments",
      "path_params": {
        "owner": "GitHub username or org",
        "repo": "Repository name",
        "issue_number": "Issue or pull request number"
      },
      "headers": {
        "Content-Type": "application/json"
      },
      "body_params": {
        "body": "Text of the comment to post"
      },
      "examples": [
        {
          "url": "https://api.github.com/repos/octocat/hello-world/issues/1347/comments",
          "parameters": {
            "owner": "octocat",
            "repo": "hello-world",
            "issue_number": "1347",
            "body": "Thanks for the fix — looks good to me!"
          }
        }
      ]
    },
    {
      "name": "get_user_commit_stats",
      "label": "📈 User Commit Stats",
      "description": "Get commit history by author for a repo.",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/commits",
      "path_params": {
        "owner": "GitHub username or org",
        "repo": "Repository name"
      },
      "query_params": {
        "author": "Filter commits by GitHub username",
        "since": "ISO 8601 date to start from",
        "until": "ISO 8601 date to end at"
      },
      "examples": [
        {
          "url": "https://api.github.com/repos/octocat/hello-world/commits?author=octocat&since=2025-04-01T00:00:00Z",
          "parameters": {
            "owner": "octocat",
            "repo": "hello-world",
            "author": "octocat",
            "since": "2025-04-01T00:00:00Z"
          }
        }
      ]
    },
    {
      "name": "summarize_recent_activity",
      "label": "🗓️ Recent Activity",
      "description": "Fetch issues and PRs updated recently.",
      "method": "GET",
      "path": "/repos/{owner}/{repo}/issues",
      "path_params": {
        "owner": "GitHub username or org",
        "repo": "Repository name"
      },
      "query_params": {
        "since": "Return items updated since this ISO 8601 timestamp",
        "state": "open, closed, or all",
        "sort": "Sort field (e.g. updated)",
        "direction": "Sort direction (asc or desc)"
      },
      "examples": [
        {
          "url": "https://api.github.com/repos/octocat/hello-world/issues?since=2025-04-01T00:00:00Z&state=all",
          "parameters": {
            "owner": "octocat",
            "repo": "hello-world",
            "since": "2025-04-01T00:00:00Z",
            "state": "all"
          }
        }
      ]
    },
    {
      "name": "create_review_comment",
      "label": "📝 PR Review Comment",
      "description": "Create an inline review comment on a pull request diff.",
      "method": "POST",
      "path": "/repos/{owner}/{repo}/pulls/{pull_number}/comments",
      "path_params": {
        "owner": "GitHub username or org",
        "repo": "Repository name",
        "pull_number": "Pull request number"
      },
      "headers": {
        "Content-Type": "application/json"
      },
      "body_params": {
        "body": "Text of the comment",
        "commit_id": "SHA of the commit to comment on",
        "path": "Relative file path to comment on",
        "position": "Line index in the diff to attach the comment"
      },
      "examples": [
        {
          "url": "https://api.github.com/repos/octocat/hello-world/pulls/42/comments",
          "parameters": {
            "owner": "octocat",
            "repo": "hello-world",
            "pull_number": "42",
            "body": "Great catch! Consider renaming this variable.",
            "commit_id": "abc123sha",
            "path": "src/main.py",
            "position": 12
          }
        }
      ]
    }
  ]
}